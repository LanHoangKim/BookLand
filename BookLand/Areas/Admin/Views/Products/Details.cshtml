@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}
<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <nav class="crumbs"><a asp-controller="Home" asp-action="Index">Tổng quan</a><span>/</span><a asp-action="Index">Sản phẩm</a><span>/</span><span class="current">#@Model.ProductId</span></nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary"><i class="fa-regular fa-pen-to-square me-1"></i>Sửa sản phẩm</a>
        @if (Model.ProductDetail != null)
        {
            <a asp-controller="ProductDetails" asp-action="Edit" asp-route-id="@Model.ProductDetail.ProductDetailId" class="btn btn-outline-secondary"><i class="fa-solid fa-list me-1"></i>Sửa chi tiết / tồn kho</a>
        }
        else
        {
            <a asp-controller="ProductDetails" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-outline-secondary"><i class="fa-solid fa-plus me-1"></i>Thêm chi tiết</a>
        }
        <a asp-action="Index" class="btn btn-light">Quay lại</a>
    </div>
</div>

@* Dùng chung partial với trang chi tiết sản phẩm của khách hàng, ẩn nút MUA HÀNG *@
<partial name="_ProductDetailPartial" model="new ProductDetailPartialModel { Product = Model, ShowPurchase = false }" />

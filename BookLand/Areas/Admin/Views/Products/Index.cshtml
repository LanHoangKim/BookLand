@model PagedList<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!, "Quản lý hàng hóa", true)' />

<div class="card">
    <form method="get" class="toolbar">
        <div class="d-flex gap-2 flex-wrap">
            <div class="input-group" style="width:320px">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên sản phẩm..." />
            </div>
            <select name="categoryId" asp-items="ViewBag.CategoryId" class="form-select auto-submit" style="width:240px">
                <option value="">Tất cả danh mục</option>
            </select>
            <button class="btn btn-outline-secondary" type="submit">Lọc</button>
        </div>
        <span class="text-muted">@Model.TotalItems sản phẩm</span>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 admin-table">
            <thead>
                <tr>
                    <th style="width:70px">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Số lượng tồn</th>
                    <th>Chủng loại</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    int stock = p.StockQuantity();
                    <tr class="@(p.IsActive ? "" : "opacity-50")">
                        <td><img src="@p.ImageUrl" class="thumb" alt="" /></td>
                        <td>
                            <div class="fw-500">@p.ProductName</div>
                            @if (!p.IsActive) { <span class="badge bg-secondary">Ngừng bán</span> }
                            @if (p.IsFeatured) { <span class="badge bg-warning-subtle text-warning-emphasis">Nổi bật</span> }
                            @if (p.IsFlashSale) { <span class="badge bg-danger-subtle text-danger">Flash Sale</span> }
                        </td>
                        <td class="text-end">
                            <b class="text-brand">@p.Price.ToVnd()</b>
                            @if (p.DiscountPercent() > 0)
                            {
                                <div class="small text-muted text-decoration-line-through">@p.OriginalPrice.ToVnd()</div>
                            }
                        </td>
                        <td class="text-center"><span class="badge fs-6 @(stock == 0 ? "bg-danger" : stock <= 10 ? "bg-warning text-dark" : "bg-success-subtle text-success")">@stock</span></td>
                        <td>@p.Category.CategoryName</td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-outline-secondary" title="Chi tiết"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-outline-primary" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.ProductId" class="btn btn-outline-danger" title="Xóa"><i class="fa-regular fa-trash-can"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PaginationModel { Page = Model.Page, TotalPages = Model.TotalPages }" />
</div>

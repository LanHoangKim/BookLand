@model List<NamedCountItem<Supplier>>
@{
    ViewData["Title"] = "Nhà cung cấp";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!, "Quản lý danh mục", true)' />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 admin-table">
            <thead>
                <tr><th style="width:60px">Mã</th><th>Tên nhà cung cấp</th><th>Địa chỉ</th><th>Website</th><th class="text-center">Số sản phẩm</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Item.SupplierId</td>
                        <td class="fw-500">@x.Item.SupplierName</td>
                        <td>@(x.Item.Address ?? "—")</td>
                        <td>@(x.Item.Website ?? "—")</td>
                        <td class="text-center"><span class="badge bg-primary-subtle text-primary">@x.ProductCount</span></td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@x.Item.SupplierId" class="btn btn-outline-secondary" title="Chi tiết"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@x.Item.SupplierId" class="btn btn-outline-primary" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@x.Item.SupplierId" class="btn btn-outline-danger" title="Xóa"><i class="fa-regular fa-trash-can"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

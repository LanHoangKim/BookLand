@model PagedList<NamedCountItem<Author>>
@{
    ViewData["Title"] = "Tác giả";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!, "Quản lý danh mục", true)' />

<div class="card">
    <div class="toolbar">
        <partial name="_SearchBox" model="ViewBag.Search as string" view-data='new ViewDataDictionary(ViewData) { ["Placeholder"] = "Tìm theo tên tác giả..." }' />
        <span class="text-muted">@Model.TotalItems tác giả</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 admin-table">
            <thead>
                <tr><th style="width:60px">Mã</th><th>Tên tác giả</th><th>Quốc tịch</th><th class="text-center">Năm sinh</th><th class="text-center">Số sản phẩm</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Items)
                {
                    <tr>
                        <td>@x.Item.AuthorId</td>
                        <td class="fw-500">@x.Item.AuthorName</td>
                        <td>@(x.Item.Nationality ?? "—")</td>
                        <td class="text-center">@(x.Item.BirthYear?.ToString() ?? "—")</td>
                        <td class="text-center"><span class="badge bg-primary-subtle text-primary">@x.ProductCount</span></td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@x.Item.AuthorId" class="btn btn-outline-secondary" title="Chi tiết"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@x.Item.AuthorId" class="btn btn-outline-primary" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@x.Item.AuthorId" class="btn btn-outline-danger" title="Xóa"><i class="fa-regular fa-trash-can"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PaginationModel { Page = Model.Page, TotalPages = Model.TotalPages }" />
</div>

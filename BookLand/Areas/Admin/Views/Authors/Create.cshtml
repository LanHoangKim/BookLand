@model Author
@{
    ViewData["Title"] = "Thêm tác giả";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!, "Tác giả")' />
<div class="card">
    <form asp-action="Create" method="post" class="card-body" novalidate>
        <partial name="_Form" model="Model" />
        <hr />
        <button type="submit" class="btn btn-brand"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

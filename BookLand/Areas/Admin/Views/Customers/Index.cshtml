@model PagedList<CustomerIndexItem>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!)' />

<div class="card">
    <div class="toolbar">
        <partial name="_SearchBox" model="ViewBag.Search as string" view-data='new ViewDataDictionary(ViewData) { ["Placeholder"] = "Tìm theo tên, email, số điện thoại..." }' />
        <span class="text-muted">@Model.TotalItems khách hàng</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 admin-table">
            <thead><tr><th style="width:60px">Mã</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Địa chỉ</th><th class="text-center">Số đơn</th><th class="text-end">Tổng chi tiêu</th><th>Ngày đăng ký</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model.Items)
                {
                    var c = x.Customer;
                    <tr>
                        <td>@c.CustomerId</td>
                        <td class="fw-500">@c.FullName</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td class="text-truncate" style="max-width:220px">@(c.Address ?? "—")</td>
                        <td class="text-center"><span class="badge bg-primary-subtle text-primary">@x.OrderCount</span></td>
                        <td class="text-end">@x.TotalSpent.ToVnd()</td>
                        <td>@c.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="actions"><a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary"><i class="fa-regular fa-eye me-1"></i>Chi tiết</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PaginationModel { Page = Model.Page, TotalPages = Model.TotalPages }" />
</div>

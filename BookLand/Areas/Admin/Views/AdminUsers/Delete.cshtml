@model AdminUser
@{
    ViewData["Title"] = "Xóa người quản trị";
}
<partial name="_PageHeader" model='new PageHeaderModel(ViewData["Title"]!.ToString()!, "Quản lý người dùng")' />
<div class="card">
    <div class="card-body">
        <table class="table table-borderless info-table" style="max-width:700px">
            <tr><th>Tên đăng nhập</th><td class="fw-bold">@Model.Username</td></tr>
            <tr><th>Họ tên</th><td>@Model.FullName</td></tr>
            <tr><th>Vai trò</th><td>@Model.Role</td></tr>
        </table>
        <partial name="_DeleteGuard" />
    </div>
</div>

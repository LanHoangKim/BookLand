@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    bool failed = ViewBag.RegisterFailed == true;
}

<div class="container auth-page">
    <div class="box auth-box">
        <div class="auth-tabs">
            <a class="auth-tab" asp-action="Login">Đăng nhập</a>
            <a class="auth-tab active" asp-action="Register">Đăng ký</a>
        </div>

        <form asp-action="Register" method="post" class="auth-form" data-require-filled novalidate>
            @if (failed)
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation"></i> Đăng ký thất bại. Vui lòng kiểm tra lại các thông tin bên dưới.
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-box"></div>

            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="input" placeholder="Nhập họ và tên" autocomplete="name" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" class="input" placeholder="Nhập số điện thoại" autocomplete="tel" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input" placeholder="Nhập email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <div class="password-wrap">
                    <input asp-for="Password" class="input" placeholder="Mật khẩu từ 6 ký tự" autocomplete="new-password" />
                    <button type="button" class="toggle-password">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="password-wrap">
                    <input asp-for="ConfirmPassword" class="input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    <button type="button" class="toggle-password">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn-red btn-auth">Đăng ký</button>
            <p class="auth-terms">Bằng việc đăng ký, bạn đã đồng ý với @StoreInfo.Name về <a href="#">Điều khoản dịch vụ</a> &amp; <a href="#">Chính sách bảo mật</a>.</p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

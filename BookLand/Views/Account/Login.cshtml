@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container auth-page">
    <div class="box auth-box">
        <div class="auth-tabs">
            <a class="auth-tab active" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
            <a class="auth-tab" asp-action="Register">Đăng ký</a>
        </div>

        <form asp-action="Login" method="post" class="auth-form" data-require-filled novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-box"></div>

            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="input" placeholder="Nhập số điện thoại hoặc email" autocomplete="username" />
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <div class="password-wrap">
                    <input asp-for="Password" class="input" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                    <button type="button" class="toggle-password">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="auth-row">
                <label class="check-row"><input asp-for="RememberMe" /> <span>Ghi nhớ đăng nhập</span></label>
                <a href="#" class="forgot-link" title="Vui lòng liên hệ hotline @StoreInfo.Hotline để lấy lại mật khẩu">Quên mật khẩu?</a>
            </div>
            <button type="submit" class="btn-red btn-auth">Đăng nhập</button>
            <p class="auth-switch">Bạn chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
